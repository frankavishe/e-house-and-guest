# Copy to .env:  Copy-Item .env.example .env
# Defaults run everything locally with fakes (mock payments, console SMS, MinIO storage).
# NEVER commit real secrets. Generate production values with the commands noted below.

ENV=dev                      # dev | test | staging | prod

# --- Host ports for docker-compose (change if another stack already uses them) ---
# If you change DB_PORT/DB_TEST_PORT/MINIO_PORT, update the host URLs below to match.
DB_PORT=5432
DB_TEST_PORT=5433
API_PORT=8000
WEB_PORT=3000
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# --- Database (PostgreSQL 16) ---------------------------------------------
# Host values; docker-compose overrides these with service hostnames for api/worker.
DATABASE_URL=postgresql+asyncpg://rental:rental@localhost:5432/rental
TEST_DATABASE_URL=postgresql+asyncpg://rental:rental@localhost:5433/rental_test

# --- Auth (R10) -------------------------------------------------------------
# python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=dev-only-change-me-jwt-secret-32-bytes
JWT_ACCESS_TTL_SECONDS=900          # 15 min
JWT_REFRESH_TTL_SECONDS=2592000     # 30 days
OTP_HMAC_KEY=dev-only-change-me-otp-hmac-key
COOKIE_SECURE=false                 # true outside local dev

# --- Encryption at rest for NIDA/TIN (R18) -----------------------------------
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=ZGV2LW9ubHktY2hhbmdlLW1lLWZlcm5ldC1rZXktMzI=

# --- Payments (R6, R7) --------------------------------------------------------
PAYMENT_PROVIDER=mock               # mock | azampay
PAYOUT_PROVIDER=manual              # manual | mock | azampay (azampay needs the flag below)
# Unguessable path segment in the callback URL: /api/v1/webhooks/payments/{provider}/{secret}
PAYMENT_CALLBACK_SECRET=dev-only-change-me-callback-secret
PUBLIC_API_BASE_URL=http://localhost:8000
MOCK_CALLBACK_BASE_URL=               # mock callbacks target; empty = PUBLIC_API_BASE_URL
AZAMPAY_ENV=sandbox                 # sandbox | live
AZAMPAY_APP_NAME=
AZAMPAY_CLIENT_ID=
AZAMPAY_CLIENT_SECRET=
AZAMPAY_API_KEY=
# Verify: exact callback auth scheme (research.md R6)
AZAMPAY_CALLBACK_PASSWORD=
# Disbursement stays off (manual payouts) until R7 is verified against the sandbox.
AZAMPAY_DISBURSE_ENABLED=false
AZAMPAY_DISBURSE_SOURCE_NAME=
AZAMPAY_DISBURSE_SOURCE_BANK=
AZAMPAY_DISBURSE_SOURCE_ACCOUNT=

# --- SMS (R11) ----------------------------------------------------------------
SMS_PROVIDER=console                # console | beem
BEEM_API_KEY=
BEEM_SECRET_KEY=
# Sender ID must be registered with Beem/TCRA
BEEM_SENDER_ID=

# --- Object storage (R12) -----------------------------------------------------
STORAGE_PROVIDER=s3                 # s3 | local
S3_ENDPOINT_URL=http://localhost:9000
# Endpoint written into presigned upload/download URLs (browser-reachable). Empty = S3_ENDPOINT_URL.
S3_PRESIGN_ENDPOINT_URL=
S3_PUBLIC_BASE_URL=http://localhost:9000/public
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_PUBLIC=public
S3_BUCKET_PRIVATE=private
UPLOAD_MAX_BYTES=10485760           # 10 MB

# --- Business settings ---------------------------------------------------------
BUSINESS_TIMEZONE=Africa/Dar_es_Salaam
DEFAULT_LANGUAGE=sw

# --- Frontend -------------------------------------------------------------------
API_INTERNAL_URL=http://localhost:8000          # server-side target of the /api/* rewrite
NEXT_PUBLIC_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
